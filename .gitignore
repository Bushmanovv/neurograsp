# --- Deployment staging -----------------------------------------------------
# raspberry-pi/install.sh expects a copy of the classifier beside it. The repo
# keeps exactly one copy, in eeg-classifier/ — the staged one is generated:
#   cd raspberry-pi && rsync -a --exclude DATA --exclude .venv \
#       --exclude __pycache__ ../eeg-classifier/ EEG_GRADUATIO_PROJECT/
raspberry-pi/EEG_GRADUATIO_PROJECT/

